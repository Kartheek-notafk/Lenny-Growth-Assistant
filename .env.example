# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny

# --- LLM provider toggle ---
# "ollama" (default, mandatory for the demo) or "openai"
LLM_PROVIDER=ollama

# Local (Ollama) — required when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud (OpenAI) — required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Retrieval / conversation tuning (optional, sensible defaults shown) ---
RETRIEVAL_TOP_K=5
HISTORY_TURNS=6
LLM_TIMEOUT_SECONDS=120
